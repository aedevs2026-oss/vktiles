# =============================================================================
# VK Tiles & Granites — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# On Vercel: Project -> Settings -> Environment Variables (add the same keys).
# Never commit `.env.local` — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required for admin, uploads, enquiries, site settings)
# Get these from: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — server-only, never expose to the browser.
# Required for: image uploads to Supabase Storage, admin DB writes, import scripts.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Admin access (required for /admin login)
# Comma-separated list of emails allowed to sign in.
# Create users in: Supabase Dashboard -> Authentication -> Users
# -----------------------------------------------------------------------------
ADMIN_ALLOWED_EMAILS=admin@vktiles.in,owner@example.com

# -----------------------------------------------------------------------------
# SMTP email (optional — contact form notifications)
# Can also be configured in Admin -> Contact -> SMTP settings (stored in Supabase).
# Env vars are used as fallback when admin SMTP is not set.
# -----------------------------------------------------------------------------

# Gmail example (use an App Password, not your normal password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-gmail-app-password

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VK Tiles & Granites
SMTP_TO_EMAIL=vktilesworld@gmail.com

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. Run Supabase SQL (in order) after creating your project:
#    - supabase/schema.sql
#    - supabase/storage.sql
#    - supabase/site-content.sql
#
# 2. Import existing catalog into Supabase (optional, one-time):
#    npm run import-supabase
#    npm run import-site-content
#
# 3. Site URL / SEO domain is set in content/data.js (seo.siteUrl), not here.
#
# 4. Product images: existing catalog uses /public/products/ paths;
#    new admin uploads go to Supabase Storage bucket "product-images".
